# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Universal LLM API Key (works for any provider: Gemini, Claude, OpenAI, DeepSeek, OpenRouter, Groq, etc.)
LLM_API_KEY=

# Optional: Custom endpoint for local LLM (e.g., Ollama: http://localhost:11434, LM Studio, vLLM)
# LLM_BASE_URL=

# Your numeric Telegram user ID. Leave empty on first run, send /start to the bot,
# and it will reply with your ID. Paste it here and restart.
OWNER_ID=

# Optional overrides
# LOG_LEVEL=INFO
# CONFIG_DIR=config
# PROMPTS_DIR=prompts
# DATA_DIR=data
